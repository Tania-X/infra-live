{
  "kind": "security_group",
  "id": "sg-bp1a2b3c4d5e",
  "name": "web-sg",
  "region": "cn-hangzhou",
  "rules": [
    {
      "direction": "ingress",
      "protocol": "tcp",
      "port_range": "22/22",
